helm upgrade --install karpenter --namespace kube-system --create-namespace \
  oci://public.ecr.aws/karpenter/karpenter \
  --version ${KARPENTER_VERSION} \
  --set serviceAccount.annotations."eks\.amazonaws\.com/role-arn"="Paste_here_KarpenterControllerRole_arn" \
  --set settings.clusterEndpoint=${CLUSTER_ENDPOINT} \
  --set settings.clusterName=${CLUSTER_NAME} \
  --wait
